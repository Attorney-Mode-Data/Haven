<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      MoshSessionManager.hasNetwork() reads connectivity through
      ConnectivityManager to gate the #421 dead-session escalation, so an
      offline device keeps waiting instead of giving up. Declared here so lint
      sees it when it analyses this library in isolation; the app module already
      requests it, so the merged permission set is unchanged.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
